### =====================================
### IHUB BANKING - Simulacao de Webhooks (V2)
### =====================================
### Documentação: https://docs.vendasonlinestore.net/docs/webhook-v2
### Eventos:
### - cashin.paid: Pagamento PIX recebido
### - cashin.refunded: Pagamento estornado
### - cashout.success: Saque aprovado
### - cashout.failed: Saque falhou
### - cashout.returned: Saque devolvido
### =====================================

@ihubTxId = 17615714245971918718644287
@ihubExternalId = pedido-teste-123

### 1. Simular Webhook - PIX Pago (cashin.paid)
# @name simulateIHubCashInPaid
POST {{host}}/v1/internal/ihubbanking/webhooks
Content-Type: application/json

{
  "event": "cashin.paid",
  "payload": {
    "transaction_id": "{{ihubTxId}}",
    "external_id": "{{ihubExternalId}}",
    "amount": 11000,
    "end_to_end_id": "E18236120202510271324s05499b347c",
    "payer": {
      "name": "João da Silva",
      "document": "99999999999",
      "ispb": "19318318",
      "institution": "NU PAGAMENTOS"
    },
    "receiver": {
      "name": "Empresa Teste",
      "document": "12345678000190",
      "ispb": "18236120",
      "institution": "BANCO EXEMPLO"
    }
  }
}

### 2. Simular Webhook - PIX Estornado (cashin.refunded)
# @name simulateIHubCashInRefunded
POST {{host}}/v1/internal/ihubbanking/webhooks
Content-Type: application/json

{
  "event": "cashin.refunded",
  "payload": {
    "transaction_id": "{{ihubTxId}}",
    "external_id": "{{ihubExternalId}}",
    "amount": 11000,
    "end_to_end_id": "E18236120202510271324s05499b347c",
    "payer": {
      "name": "João da Silva",
      "document": "99999999999",
      "ispb": "19318318",
      "institution": "NU PAGAMENTOS"
    },
    "receiver": {
      "name": "Empresa Teste",
      "document": "12345678000190",
      "ispb": "18236120",
      "institution": "BANCO EXEMPLO"
    }
  }
}

