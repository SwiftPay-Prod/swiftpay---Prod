    "transactionId": "ERROR12345678901234567890",
    "status": "PAID",
    "amount": 10000,
    "paidAt": "2025-12-19T05:56:27.539Z",
    "transactionType": "DYNAMIC",
    "payerInfo": {
      "name": "Joao Silva",
      "document": "12345678901"
    },
    "accountId": "66"
  }
}

