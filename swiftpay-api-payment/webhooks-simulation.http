@host = http://localhost:5166
@webhookToken = whsec_bankizi_default_token_change_in_production
@txId = 6EH8VGBEFRUX72Q7M7HKTXOZPG

### =====================================
### WEBHOOKS SIMULATION - Simulacao de Webhooks (Localhost Only)
### =====================================
### IMPORTANTE: 
### - Estes endpoints funcionam APENAS em localhost e em ambiente Development
### - A autenticação é feita pelo middleware AcquirerWebhookAuthMiddleware
### - Modos de autenticação configuráveis via Admin:
###   - Token: usa WebhookToken no header (Authorization, X-Webhook-Token, etc)
###   - Ip: valida IP de origem (WebhookAllowedIps)
###   - TokenAndIp: ambos obrigatórios
### - Configure via: PATCH /v1/admin/acquirers/{id}
### =====================================

### =====================================
### BANKIZI - Simulacao de Webhooks
### =====================================

### 1. Simular Webhook - PIX Pago (Paid)
# @name simulatePaid
POST {{host}}/v1/internal/bankizi/webhooks/dev/simulate
Content-Type: application/json
Authorization: Bearer {{webhookToken}}

{
  "event": "PIX_IN",
  "type": "PIX_IN",
  "data": {
    "txId": "{{txId}}",
    "transactionId": "PAID123456789012345678",
    "endToEndId": "EN69U7ROGLPKOPE1NMVOVISX",
    "status": "PAID",
    "amount": 15500,
    "endToEndIdRefunded": null,
    "amountRefunded": null,
    "refundedAt": null,
    "paidAt": "2025-12-19T05:56:27.539Z",
    "transactionType": "DYNAMIC",
    "payerInfo": {
      "name": "Joao Silva",
      "document": "12345678901"
    },
    "externalId": null,
    "account": null,
    "accountId": "66"
  }
}

