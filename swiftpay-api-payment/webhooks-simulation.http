### =====================================
### BANKIZI - PIX_OUT (Cashout/Saque) Webhooks
### =====================================
### Status possíveis: GENERATED, DONE, FAILED, REJECT, REFUNDED, PARTIALLY_REFUNDED
### IMPORTANTE: O txId deve ser o mesmo retornado pela Bankizi ao criar o saque
### (armazenado no campo AcquirerPayoutId do Payout)

@payoutTxId = ADOUG086DGSH4534RWRGE66D304

### 1. Simular Webhook PIX_OUT - Saque Concluído (DONE)
# @name simulateCashoutDone
POST {{host}}/v1/internal/bankizi/webhooks
Content-Type: application/json
Authorization: Bearer {{webhookToken}}

{
  "event": "PIX_OUT",
  "data": {
    "txId": "{{payoutTxId}}",
    "transactionId": "CASHOUT_DONE_123456789",
    "endToEndId": "E00000000202501152345CASHOUT01",
    "status": "DONE",
    "amount": 50000,
    "amountRefunded": null,
    "endToEndIdRefunded": null,
    "refundedAt": null,
    "paidAt": "2025-01-15T14:30:00.000Z",
    "transactionType": "PIX_KEY",
    "receiverInfo": {
      "name": "João da Silva",
      "document": "12345678900"
    },
    "account": null,
    "accountId": "66"
  }
}

