    "holderDocument": "12345678000190"
}

### Create Cashout Account - PIX Random Key
POST {{safefy_api_HostAddress}}/v1/merchant/{{merchantId}}/cashout-accounts
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "pixKeyType": "Random",
    "pixKey": "123e4567-e89b-12d3-a456-426614174000",
    "holderName": "João da Silva",
    "holderDocument": "12345678901"
}

###############################################################################
# CASHOUT ACCOUNTS - VERIFICATION
###############################################################################

### Verify Cashout Account (Enter the 6-digit code received by email)
POST {{safefy_api_HostAddress}}/v1/merchant/{{merchantId}}/cashout-accounts/{{payoutAccountId}}/verify
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "code": "{{verificationCode}}"
}

### Resend Verification Code
POST {{safefy_api_HostAddress}}/v1/merchant/{{merchantId}}/cashout-accounts/{{payoutAccountId}}/resend-code
Authorization: Bearer {{token}}

###############################################################################
# CASHOUT ACCOUNTS - MANAGEMENT
###############################################################################

### List Cashout Accounts
GET {{safefy_api_HostAddress}}/v1/merchant/{{merchantId}}/cashout-accounts
Authorization: Bearer {{token}}

### List Cashout Accounts (By Single Status)
GET {{safefy_api_HostAddress}}/v1/merchant/{{merchantId}}/cashout-accounts?statuses=Active
Authorization: Bearer {{token}}

### List Cashout Accounts (By Multiple Statuses - Active and PendingVerification)
GET {{safefy_api_HostAddress}}/v1/merchant/{{merchantId}}/cashout-accounts?statuses=Active&statuses=Pending
Authorization: Bearer {{token}}

### List Cashout Accounts (All including Inactive)
GET {{safefy_api_HostAddress}}/v1/merchant/{{merchantId}}/cashout-accounts?statuses=Active&statuses=PendingVerification&statuses=Inactive
Authorization: Bearer {{token}}

### Set Default Cashout Account
PATCH {{safefy_api_HostAddress}}/v1/merchant/{{merchantId}}/cashout-accounts/{{payoutAccountId}}/set-default
Content-Type: application/json
Authorization: Bearer {{token}}

{}

### Delete Cashout Account
DELETE {{safefy_api_HostAddress}}/v1/merchant/{{merchantId}}/cashout-accounts/{{payoutAccountId}}
Authorization: Bearer {{token}}

###############################################################################
# PAYOUTS - REQUEST
###############################################################################

### Request Payout (Default Account)
POST {{safefy_api_HostAddress}}/v1/merchant/{{merchantId}}/payouts
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "amount": 5000,
    "environment": "Sandbox",
    "payoutAccountId": "{{payoutAccountId}}"
}

### Request Payout (Specific Account)
POST {{safefy_api_HostAddress}}/v1/merchant/{{merchantId}}/payouts
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "amount": 10000,
    "payoutAccountId": "{{payoutAccountId}}",
    "environment": "Sandbox"
}

### Request Payout (Full Balance)
POST {{safefy_api_HostAddress}}/v1/merchant/{{merchantId}}/payouts
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "amount": 100000,
    "environment": "Sandbox"
}

###############################################################################
# PAYOUTS - LIST
###############################################################################

### List Payouts
GET {{safefy_api_HostAddress}}/v1/merchant/{{merchantId}}/payouts
Authorization: Bearer {{token}}

### List Payouts (Paginated)
GET {{safefy_api_HostAddress}}/v1/merchant/{{merchantId}}/payouts?page=1&pageSize=30
Authorization: Bearer {{token}}

### List Payouts (By Status: Pending, Processing, Completed, Failed, Cancelled)
GET {{safefy_api_HostAddress}}/v1/merchant/{{merchantId}}/payouts?status=Pending
Authorization: Bearer {{token}}

### List Payouts (By Period)
GET {{safefy_api_HostAddress}}/v1/merchant/{{merchantId}}/payouts?startDate=2024-01-01&endDate=2024-12-31
Authorization: Bearer {{token}}

### List Payouts (Completed Only)
GET {{safefy_api_HostAddress}}/v1/merchant/{{merchantId}}/payouts?status=Completed
Authorization: Bearer {{token}}

###############################################################################
# PAYOUTS - READ
###############################################################################

### Get Payout Details
GET {{safefy_api_HostAddress}}/v1/merchant/{{merchantId}}/payouts/{{payoutId}}
Authorization: Bearer {{token}}
