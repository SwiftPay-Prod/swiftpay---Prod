###############################################################################
# CASHOUT ACCOUNTS - CREATE
###############################################################################

### Create Cashout Account - PIX CPF
POST {{safefy_api_HostAddress}}/v1/merchant/{{merchantId}}/cashout-accounts
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "pixKeyType": "Cpf",
    "pixKey": "06209730132",
    "holderName": "Matheus da Silva",
    "holderDocument": "12345678901"
}

### Create Cashout Account - PIX Email
POST {{safefy_api_HostAddress}}/v1/merchant/{{merchantId}}/cashout-accounts
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "pixKeyType": "Email",
    "pixKey": "joao@email.com",
    "holderName": "João da Silva",
    "holderDocument": "12345678901"
}

### Create Cashout Account - PIX Phone
POST {{safefy_api_HostAddress}}/v1/merchant/{{merchantId}}/cashout-accounts
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "pixKeyType": "Phone",
    "pixKey": "+5511999887766",
    "holderName": "João da Silva",
    "holderDocument": "12345678901"
}

### Create Cashout Account - PIX CNPJ
POST {{safefy_api_HostAddress}}/v1/merchant/{{merchantId}}/cashout-accounts
Content-Type: application/json
