          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \n  \"Action\" as \"Ação\",\n  COUNT(*) as \"Total\",\n  COUNT(*) FILTER (WHERE \"Status\" = 'Success') as \"Sucesso\",\n  COUNT(*) FILTER (WHERE \"Status\" = 'Failed') as \"Falha\",\n  ROUND((COUNT(*) FILTER (WHERE \"Status\" = 'Success') * 100.0 / NULLIF(COUNT(*), 0))::numeric, 2) as \"Taxa Sucesso %\",\n  COALESCE(AVG(\"ResponseTimeMs\")::int, 0) as \"Tempo Médio (ms)\"\nFROM \"ApiLogs\" \nWHERE \"CreatedAt\" >= $__timeFrom() \n  AND \"CreatedAt\" <= $__timeTo()\nGROUP BY \"Action\"\nORDER BY \"Total\" DESC",
          "refId": "A"
        }
      ],
      "title": "📊 Métricas por Ação",
      "type": "table"
