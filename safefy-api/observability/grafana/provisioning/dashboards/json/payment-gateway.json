          "rawQuery": true,
          "rawSql": "SELECT \n  \"CreatedAt\" as \"Data/Hora\",\n  \"Action\" as \"Ação\",\n  \"HttpMethod\" as \"Método\",\n  \"StatusCode\" as \"HTTP Code\",\n  \"Status\",\n  COALESCE(\"ResponseTimeMs\"::text || ' ms', 'N/A') as \"Tempo\",\n  COALESCE(\"IpAddress\", 'N/A') as \"IP\"\nFROM \"ApiLogs\" \nWHERE \"CreatedAt\" >= $__timeFrom() \n  AND \"CreatedAt\" <= $__timeTo()\nORDER BY \"CreatedAt\" DESC\nLIMIT 50",
          "refId": "A"
        }
