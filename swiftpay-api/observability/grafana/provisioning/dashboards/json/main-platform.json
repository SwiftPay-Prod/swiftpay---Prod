          "rawSql": "SELECT \n  COALESCE(\"Location\", 'Desconhecido') as \"Localização\",\n  COUNT(*) as \"Total de Acessos\",\n  COUNT(*) FILTER (WHERE \"Status\" = 'Success') as \"Sucesso\",\n  COUNT(*) FILTER (WHERE \"Status\" = 'Failed') as \"Falha\"\nFROM \"SecurityLogs\" \nWHERE \"Action\" = 'SignIn'\n  AND \"CreatedAt\" >= $__timeFrom() \n  AND \"CreatedAt\" <= $__timeTo()\nGROUP BY \"Location\"\nORDER BY \"Total de Acessos\" DESC\nLIMIT 15",
