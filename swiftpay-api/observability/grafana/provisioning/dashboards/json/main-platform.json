          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT \n  date_trunc('hour', \"CreatedAt\") as time,\n  COUNT(*) FILTER (WHERE \"Status\" = 'Success') as \"Sucesso\",\n  COUNT(*) FILTER (WHERE \"Status\" = 'Failed') as \"Falha\"\nFROM \"SecurityLogs\" \nWHERE \"Action\" = 'SignIn' \n  AND \"CreatedAt\" >= $__timeFrom() \n  AND \"CreatedAt\" <= $__timeTo()\nGROUP BY 1\nORDER BY 1",
