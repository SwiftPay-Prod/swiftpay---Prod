          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \n  \"IpAddress\" as \"IP\",\n  COUNT(*) as \"Total Falhas\",\n  COUNT(DISTINCT \"UserEmail\") as \"Emails Diferentes\",\n  MAX(\"CreatedAt\") as \"Última Tentativa\"\nFROM \"SecurityLogs\" \nWHERE \"Action\" = 'SignIn' \n  AND \"Status\" = 'Failed'\n  AND \"CreatedAt\" >= $__timeFrom() \n  AND \"CreatedAt\" <= $__timeTo()\n  AND \"IpAddress\" IS NOT NULL\nGROUP BY \"IpAddress\"\nHAVING COUNT(*) >= 3\nORDER BY \"Total Falhas\" DESC\nLIMIT 20",
          "refId": "A"
        }
      ],
