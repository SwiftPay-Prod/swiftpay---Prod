          "rawSql": "SELECT \n  m.\"Name\" as \"Merchant\",\n  COALESCE(SUM(p.\"Amount\"), 0) / 100.0 as \"Volume Hoje\",\n  COUNT(p.\"Id\") as \"Transações Hoje\"\nFROM \"Merchants\" m\nLEFT JOIN \"Payments\" p ON p.\"MerchantId\" = m.\"Id\" AND p.\"Status\" = 'Completed' AND p.\"Environment\" = 'Production' AND DATE(p.\"CompletedAt\") = CURRENT_DATE\nWHERE m.\"Status\" = 'Active'\nGROUP BY m.\"Id\", m.\"Name\"\nHAVING COALESCE(SUM(p.\"Amount\"), 0) > 0\nORDER BY \"Volume Hoje\" DESC\nLIMIT 10",
