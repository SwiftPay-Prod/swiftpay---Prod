          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \n  m.\"Name\" as \"Merchant\",\n  COALESCE(SUM(p.\"Amount\"), 0) / 100.0 as \"Volume\",\n  COUNT(p.\"Id\") as \"Transações\"\nFROM \"Merchants\" m\nLEFT JOIN \"Payments\" p ON p.\"MerchantId\" = m.\"Id\" AND p.\"Status\" = 'Completed' AND p.\"Environment\" = 'Production'\nWHERE m.\"Status\" = 'Active'\nGROUP BY m.\"Id\", m.\"Name\"\nORDER BY \"Volume\" DESC\nLIMIT 10",
          "refId": "A"
        }
      ],
      "title": "🏆 Top 10 Merchants por Volume",
