###############################################################################
# DASHBOARD
###############################################################################

### Get Admin Dashboard (KPIs)
GET {{safefy_api_HostAddress}}/v1/admin/dashboard
Accept: application/json
Authorization: Bearer {{adminToken}}

###############################################################################
# USER MANAGEMENT
###############################################################################

### List Users
GET {{safefy_api_HostAddress}}/v1/admin/users?page=1&pageSize=10
Accept: application/json
Authorization: Bearer {{adminToken}}

### List Users by Status (Active)
GET {{safefy_api_HostAddress}}/v1/admin/users?page=1&pageSize=10&status=Active
Accept: application/json
Authorization: Bearer {{adminToken}}

### List Users by Status (Inactive)
GET {{safefy_api_HostAddress}}/v1/admin/users?page=1&pageSize=10&status=Inactive
Accept: application/json
Authorization: Bearer {{adminToken}}

### List Users by Status (Suspended)
GET {{safefy_api_HostAddress}}/v1/admin/users?page=1&pageSize=10&status=Suspended
Accept: application/json
Authorization: Bearer {{adminToken}}

### List Users by Role (Merchant)
GET {{safefy_api_HostAddress}}/v1/admin/users?page=1&pageSize=10&role=Merchant
Accept: application/json
Authorization: Bearer {{adminToken}}

### List Users by Role (Admin)
GET {{safefy_api_HostAddress}}/v1/admin/users?page=1&pageSize=10&role=Admin
Accept: application/json
Authorization: Bearer {{adminToken}}

### Search Users by Name or Email
GET {{safefy_api_HostAddress}}/v1/admin/users?page=1&pageSize=10&search=matheus
Accept: application/json
Authorization: Bearer {{adminToken}}

### Get User Details
GET {{safefy_api_HostAddress}}/v1/admin/user/{{userId}}
Accept: application/json
Authorization: Bearer {{adminToken}}

### Activate User
POST {{safefy_api_HostAddress}}/v1/admin/user/{{userId}}/activate
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
    "reason": "Reativação aprovada após análise."
}

### Inactivate User
POST {{safefy_api_HostAddress}}/v1/admin/user/{{userId}}/inactivate
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
    "reason": "Solicitação do usuário."
}

### Suspend User
POST {{safefy_api_HostAddress}}/v1/admin/user/{{userId}}/suspend
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
    "reason": "Violação dos termos de uso."
}

### Reset User Password
POST {{safefy_api_HostAddress}}/v1/admin/user/{{userId}}/reset-password
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{}

### Send User Email Confirmation
POST {{safefy_api_HostAddress}}/v1/admin/user/{{userId}}/send-email-confirmation
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{}

### Update User Role - Set as Admin
PATCH {{safefy_api_HostAddress}}/v1/admin/user/{{userId}}/role
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
    "role": "Admin"
}

### Update User Role - Set as Merchant
PATCH {{safefy_api_HostAddress}}/v1/admin/user/{{userId}}/role
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
    "role": "Merchant"
}

### Update User Role - Set as Support
PATCH {{safefy_api_HostAddress}}/v1/admin/user/{{userId}}/role
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
    "role": "Support"
}

###############################################################################
# MERCHANT MANAGEMENT
###############################################################################

### List Pending Merchants (Default: Pending + UnderReview)
GET {{safefy_api_HostAddress}}/v1/admin/merchants?page=1&pageSize=10
Accept: application/json
Authorization: Bearer {{adminToken}}

### List Merchants by KYC Status (Pending)
GET {{safefy_api_HostAddress}}/v1/admin/merchants?page=1&pageSize=10&kycStatus=Pending
Accept: application/json
Authorization: Bearer {{adminToken}}

### List Merchants by KYC Status (UnderReview)
GET {{safefy_api_HostAddress}}/v1/admin/merchants?page=1&pageSize=10&kycStatus=UnderReview
Accept: application/json
Authorization: Bearer {{adminToken}}

### List Merchants by KYC Status (Approved)
GET {{safefy_api_HostAddress}}/v1/admin/merchants?page=1&pageSize=10&kycStatus=Approved
Accept: application/json
Authorization: Bearer {{adminToken}}

### List Merchants by KYC Status (Rejected)
GET {{safefy_api_HostAddress}}/v1/admin/merchants?page=1&pageSize=10&kycStatus=Rejected
Accept: application/json
Authorization: Bearer {{adminToken}}

### List Merchants by KYC Status (Complement)
GET {{safefy_api_HostAddress}}/v1/admin/merchants?page=1&pageSize=10&kycStatus=Complement
Accept: application/json
Authorization: Bearer {{adminToken}}

### Evaluate Merchant KYC - Approve
POST {{safefy_api_HostAddress}}/v1/admin/merchant/{{merchantId}}/evaluate
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
    "status": "Approved",
    "reason": "Documentação completa e válida."
}

### Evaluate Merchant KYC - Reject
POST {{safefy_api_HostAddress}}/v1/admin/merchant/{{merchantId}}/evaluate
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
    "status": "Rejected",
    "reason": "Documentos ilegíveis. Por favor, envie documentos com melhor qualidade."
}

### Evaluate Merchant KYC - Request Complement
POST {{safefy_api_HostAddress}}/v1/admin/merchant/{{merchantId}}/evaluate
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
    "status": "Complement",
    "reason": "Precisamos de documentos adicionais para completar a análise.",
    "pendingItems": [
        {
            "type": "Document",
            "title": "Comprovante de endereço atualizado",
            "description": "Por favor, envie um comprovante de endereço com data inferior a 3 meses."
        },
        {
            "type": "Information",
            "title": "Informar faturamento mensal",
            "description": "Informe o faturamento médio mensal da empresa nos últimos 12 meses."
        }
    ]
}

###############################################################################
# ACQUIRER MANAGEMENT
###############################################################################

### List All Acquirers
GET {{safefy_api_HostAddress}}/v1/admin/acquirers?page=1&pageSize=10
Accept: application/json
Authorization: Bearer {{adminToken}}

### List Active Acquirers Only
GET {{safefy_api_HostAddress}}/v1/admin/acquirers?page=1&pageSize=10&isActive=true
Accept: application/json
Authorization: Bearer {{adminToken}}

### List Inactive Acquirers Only
GET {{safefy_api_HostAddress}}/v1/admin/acquirers?page=1&pageSize=10&isActive=false
Accept: application/json
Authorization: Bearer {{adminToken}}

### Update Acquirer - Set IP Authentication Mode
PATCH {{safefy_api_HostAddress}}/v1/admin/acquirers/{{acquirerId}}
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
    "webhookAuthMode": "Ip",
    "webhookAllowedIps": "192.168.1.1,10.0.0.0/24"
}

### Update Acquirer - Set Token Authentication Mode
PATCH {{safefy_api_HostAddress}}/v1/admin/acquirers/{{acquirerId}}
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
    "webhookAuthMode": "Token",
    "webhookToken": "whsec_your_secure_token_here"
}

###############################################################################
# PLATFORM PAYOUTS
###############################################################################

### Create Platform Payout
POST {{safefy_api_HostAddress}}/v1/admin/platform-payouts
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
    "platformPayoutAccountId": "{{platformPayoutAccountId}}",
    "totalAmount": 10000,
    "notes": "Saque da plataforma"
}

### Create Simulated Platform Payout
POST {{safefy_api_HostAddress}}/v1/admin/platform-payouts/simulated
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
    "platformPayoutAccountId": "{{platformPayoutAccountId}}",
    "totalAmount": 10000,
    "notes": "Saque simulado externo"
}

### Update Acquirer - Set Token and IP Authentication Mode
PATCH {{safefy_api_HostAddress}}/v1/admin/acquirers/{{acquirerId}}
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
    "webhookAuthMode": "TokenAndIp",
    "webhookToken": "whsec_your_secure_token_here",
    "webhookAllowedIps": "192.168.1.1"
}

