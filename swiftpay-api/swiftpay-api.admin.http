Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
    "pixCheckoutFeeMode": "PercentageOnly",
    "pixCheckoutFeePercentage": 200
}

### Update Platform Settings - All Defaults
PATCH {{safefy_api_HostAddress}}/v1/admin/platform-settings
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
    "pixMinTransactionAmount": 100,
    "pixMaxTransactionAmount": 100000000,
    "pixTimeoutMinutes": 30,
    "pixApiFeeMode": "PercentageOnly",
    "pixApiFeePercentage": 150,
    "pixCheckoutFeeMode": "PercentageOnly",
    "pixCheckoutFeePercentage": 200,
    "withdrawalFeeMode": "FixedOnly",
    "withdrawalFeeFixed": 200,
    "minWithdrawalAmount": 1000,
    "rateLimitPerMinute": 60,
    "rateLimitPerHour": 1000,
    "rateLimitPerDay": 10000
}

