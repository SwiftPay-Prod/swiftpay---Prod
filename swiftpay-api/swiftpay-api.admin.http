}

###############################################################################
# MERCHANT SETTINGS (Limits, Fees)
###############################################################################

### Update Merchant Settings - Pix Limits
PATCH {{safefy_api_HostAddress}}/v1/admin/merchant/{{merchantId}}/settings
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
    "pixMinTransactionAmount": 100,
    "pixMaxTransactionAmount": 1000000
}

### Update Merchant Settings - PIX API Fee (Fixed)
PATCH {{safefy_api_HostAddress}}/v1/admin/merchant/{{merchantId}}/settings
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
    "pixApiFeeMode": "FixedOnly",
    "pixApiFeeFixed": 100
}

### Update Merchant Settings - PIX API Fee (Percentage)
PATCH {{safefy_api_HostAddress}}/v1/admin/merchant/{{merchantId}}/settings
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
    "pixApiFeeMode": "PercentageOnly",
    "pixApiFeePercentage": 450
}

### Update Merchant Settings - PIX Checkout Fee (Fixed + Percentage)
PATCH {{safefy_api_HostAddress}}/v1/admin/merchant/{{merchantId}}/settings
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
    "pixCheckoutFeeMode": "FixedAndPercentage",
    "pixCheckoutFeeFixed": 50,
    "pixCheckoutFeePercentage": 200
}

### Update Merchant Settings - Withdrawal Fee
PATCH {{safefy_api_HostAddress}}/v1/admin/merchant/{{merchantId}}/settings
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
    "withdrawalFeeMode": "FixedOnly",
    "withdrawalFeeFixed": 500,
    "minWithdrawalAmount": 1000
}

### Update Merchant Settings - All Settings
PATCH {{safefy_api_HostAddress}}/v1/admin/merchant/{{merchantId}}/settings
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
    "pixMinTransactionAmount": 100,
    "pixMaxTransactionAmount": 1000000,
    "pixApiFeeMode": "PercentageOnly",
    "pixApiFeePercentage": 150,
    "pixCheckoutFeeMode": "FixedAndPercentage",
    "pixCheckoutFeeFixed": 50,
    "pixCheckoutFeePercentage": 200,
    "withdrawalFeeMode": "FixedOnly",
    "withdrawalFeeFixed": 500,
    "minWithdrawalAmount": 1000
}

###############################################################################
# RATE LIMITING (Payment API)
###############################################################################

### Update Merchant Rate Limit
PATCH {{safefy_api_HostAddress}}/v1/admin/merchant/{{merchantId}}/settings
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
    "rateLimitPerMinute": 60,
    "rateLimitPerHour": 1000,
    "rateLimitPerDay": 10000
}

### Increase Rate Limit for High Volume Merchant
PATCH {{safefy_api_HostAddress}}/v1/admin/merchant/{{merchantId}}/settings
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
    "rateLimitPerMinute": 200,
    "rateLimitPerHour": 5000,
    "rateLimitPerDay": 50000
}

### Reduce Rate Limit (Suspicious Activity)
PATCH {{safefy_api_HostAddress}}/v1/admin/merchant/{{merchantId}}/settings
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
    "rateLimitPerMinute": 10,
    "rateLimitPerHour": 100,
    "rateLimitPerDay": 500
}

