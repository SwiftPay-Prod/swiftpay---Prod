###############################################################################
# PAYOUT MANAGEMENT
###############################################################################

@payoutId = 019b5bd3-6343-71ac-ac6c-7e620549e37f

### List All Payouts
GET {{safefy_api_HostAddress}}/v1/admin/payouts?page=1&pageSize=20
Accept: application/json
Authorization: Bearer {{adminToken}}

### List Pending Payouts
GET {{safefy_api_HostAddress}}/v1/admin/payouts?page=1&pageSize=20&status=Pending
Accept: application/json
Authorization: Bearer {{adminToken}}

### List Processing Payouts
GET {{safefy_api_HostAddress}}/v1/admin/payouts?page=1&pageSize=20&status=Processing
Accept: application/json
Authorization: Bearer {{adminToken}}

### List Completed Payouts
GET {{safefy_api_HostAddress}}/v1/admin/payouts?page=1&pageSize=20&status=Completed
Accept: application/json
Authorization: Bearer {{adminToken}}

### List Failed Payouts
GET {{safefy_api_HostAddress}}/v1/admin/payouts?page=1&pageSize=20&status=Failed
Accept: application/json
Authorization: Bearer {{adminToken}}

### List Payouts by Merchant
GET {{safefy_api_HostAddress}}/v1/admin/payouts?page=1&pageSize=20&merchantId={{merchantId}}
Accept: application/json
Authorization: Bearer {{adminToken}}

### Search Payouts
GET {{safefy_api_HostAddress}}/v1/admin/payouts?page=1&pageSize=20&search=exemplo
Accept: application/json
Authorization: Bearer {{adminToken}}

### List Payouts by Date Range
GET {{safefy_api_HostAddress}}/v1/admin/payouts?page=1&pageSize=20&startDate=2025-01-01T00:00:00Z&endDate=2025-12-31T23:59:59Z
Accept: application/json
Authorization: Bearer {{adminToken}}

### Get Payout Details
GET {{safefy_api_HostAddress}}/v1/admin/payouts/{{payoutId}}
Accept: application/json
Authorization: Bearer {{adminToken}}

### Review Payout - Approve
POST {{safefy_api_HostAddress}}/v1/admin/payouts/{{payoutId}}/review
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
    "action": "Approve",
    "environment": "Sandbox",
    "adminComment": "Saque aprovado após verificação."
}

### Review Payout - Reject
POST {{safefy_api_HostAddress}}/v1/admin/payouts/{{payoutId}}/review
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
    "action": "Reject",
    "environment": "Sandbox",
    "reason": "Conta de destino não pode ser verificada. Por favor, verifique os dados da chave PIX."
}

###############################################################################
# ACHIEVEMENTS
###############################################################################

# NOTA: O backfill requer role "God". Use um token de usuário God.
@godToken = {{adminToken}}

### Backfill - Conceder conquistas retroativas para todos os usuários (somente God)
POST {{safefy_api_HostAddress}}/v1/admin/achievements/backfill
Content-Type: application/json
Authorization: Bearer {{godToken}}

###
